{
  "name": "popsynth",
  "version": "0.1.0",
  "description": "Thematic synthetic data generator CLI and core library.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "popsynth": "./dist/bin/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "keywords": [
    "synthetic-data",
    "data-generation",
    "cli",
    "csv",
    "schema",
    "llm"
  ],
  "homepage": "https://github.com/taylorhickman/pop_synth_data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taylorhickman/pop_synth_data.git",
    "directory": "packages/popsynth"
  },
  "bugs": {
    "url": "https://github.com/taylorhickman/pop_synth_data/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/fix-esm-imports.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "pack:dry-run": "pnpm build && npm pack --dry-run",
    "smoke": "pnpm build && node ./scripts/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@oclif/core": "^4.5.7",
    "ai": "^6.0.177",
    "js-yaml": "^4.1.1",
    "node-sql-parser": "^5.4.0",
    "papaparse": "^5.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "typescript": "^5"
  }
}
